local espActive = false
local highlights = {}

EspBtn.MouseButton1Click:Connect(function()
    espActive = not espActive
    EspBtn.Text = espActive and "Rainbow ESP: ON" or "Rainbow ESP: OFF"
    if not espActive then
        for _, hl in pairs(highlights) do
            if hl then hl:Destroy() end
        end
        highlights = {}
    end
end)

RunService.RenderStepped:Connect(function()
    local hue = (tick() % 5) / 5
    local currentRainbowColor = Color3.fromHSV(hue, 1, 1)

    if espActive then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                if not char:FindFirstChild("AxomHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "AxomHighlight"
                    hl.Adornee = char
                    hl.Parent = char
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    highlights[player] = hl
                end
                local hl = highlights[player]
                if hl then
                    hl.FillColor = currentRainbowColor
                    hl.OutlineColor = currentRainbowColor
                end
            end
        end
    else
        for player, hl in pairs(highlights) do
            if hl then hl:Destroy() end
        end
        highlights = {}
    end
end)

